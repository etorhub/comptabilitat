{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["public/*.js"],
      "rules": {
        "no-var": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "public/htmx.min.js", "public/echarts.min.js", "drizzle"]
}
