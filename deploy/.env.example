# ---------------------------------------------------------------------------
# Copia aquest fitxer a deploy/.env i omple els valors. No el pugis mai al git.
# ---------------------------------------------------------------------------

# --- Base de dades ---
POSTGRES_USER=comptabilitat
POSTGRES_PASSWORD=canvia-aquesta-contrasenya
POSTGRES_DB=comptabilitat

# --- Aplicacio ---
ENVIRONMENT=production
DEBUG=false
# Clau de signatura de sessions: genera-la amb `openssl rand -hex 32`
SECRET_KEY=canvia-aquesta-clau
# URL publica: ha de coincidir amb el hostname del tunel de Cloudflare.
PUBLIC_BASE_URL=https://comptabilitat.dossierapp.org
COOKIE_SECURE=true
TIMEZONE=Europe/Madrid

# --- Enable Banking ---
# L'identificador de l'aplicacio del panell de control d'Enable Banking.
EB_APPLICATION_ID=
# Portainer clona el git sense el PEM (gitignorat). El script
# deploy/scripts/portainer-deploy.py omple EB_PRIVATE_KEY_B64 a l'stack.
# EB_PRIVATE_KEY_PATH=/run/secrets/eb_private_key
# EB_PRIVATE_KEY_B64=
EB_DEFAULT_ASPSP_NAME=Santander
EB_DEFAULT_ASPSP_COUNTRY=ES
EB_CONSENT_DAYS=90
EB_INITIAL_HISTORY_MONTHS=24

# --- Ollama (opcional) ---
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
# El model del xat (/e/<espai>/xat). Per defecte, el mateix que OLLAMA_MODEL.
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_CHAT_TIMEOUT_SECONDS=300
# El model dels resums i informes (/e/<espai>/resums). Per defecte, el del xat.
# OLLAMA_REPORT_MODEL=qwen3:8b
# OLLAMA_REPORT_TIMEOUT_SECONDS=600

# --- Correu ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=comptabilitat@elmeudomini.cat
SMTP_STARTTLS=true
# Separats per comes. Omet la variable si no n'hi ha cap (no deixis ALERT_RECIPIENTS= buit).
# ALERT_RECIPIENTS=tu@example.com,parella@example.com

# --- Planificador ---
SCHEDULER_ENABLED=true
SYNC_CRON_HOUR=6
SYNC_CRON_MINUTE=30
# Nomes te efecte amb OLLAMA_ENABLED=true.
CLASSIFY_CRON_HOUR=3
ANALYSIS_CRON_HOUR=4
NOTIFY_CRON_HOUR=8
# Els informes redactats. Nomes tenen efecte amb OLLAMA_ENABLED=true.
# L'informe mensual es fa a aquesta hora, a partir d'aquest dia del mes seguent.
REPORT_MONTHLY_HOUR=2
REPORT_MONTHLY_DAY=3
# Segons de pausa entre l'informe d'un espai i el del seguent.
REPORT_PAUSE_SECONDS=20

# --- Tunel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Copies de seguretat ---
BACKUP_RETENTION_DAYS=30
